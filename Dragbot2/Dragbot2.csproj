<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <UserSecretsId>d3c4f7e4-6a30-46a9-bf0d-3257a414539a</UserSecretsId>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Formatters.Xml" Version="2.3.13" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
        <PackageReference Include="NetCord" Version="1.0.0-beta.28" />
        <PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.28" />
        <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.28" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Dragbot2.Resources\Dragbot2.Resources.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
